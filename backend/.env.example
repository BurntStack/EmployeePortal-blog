# BurntStack Employee Portal backend — copy to .env and fill in your values
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection string, e.g. a Supabase project (leave unset for SQLite locally)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_SSL_REQUIRE=True

# Include the marketing site's origin so burntstack.com/blog can read the
# public post feed from this backend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.burntstack.com,https://burntstack.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Google Sign-In — Client ID from Google Cloud Console (OAuth consent
# screen + Web application credential). Login is rejected entirely until
# this is set to a real value.
GOOGLE_CLIENT_ID=
# Anyone with a verified Google account on this domain can log in.
ALLOWED_EMAIL_DOMAIN=burntstack.com
# Comma-separated emails that get is_staff on every login (re-synced each
# time, so editing this takes effect immediately without touching the DB).
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Media storage (S3-compatible — Supabase Storage in production)
#
# Leave these unset for local development and uploads go to ./media on disk,
# served by Django under DEBUG. That arrangement CANNOT work when deployed:
# Vercel's filesystem is read-only outside /tmp and is discarded between
# invocations, and /media/ is not routed when DEBUG is off — which is why
# uploaded images previously rendered as broken <img> tags in production.
#
# Set all four and the backend switches to object storage automatically.
# The bucket must be PUBLIC: the URLs are written into stored post HTML and
# are read by anonymous visitors on burntstack.com/blog. Signed URLs would
# expire and break those posts, so AWS_QUERYSTRING_AUTH is forced off.
#
# Supabase: Project Settings -> Storage -> S3 connection.
# ---------------------------------------------------------------------------
AWS_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
AWS_STORAGE_BUCKET_NAME=blog-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Supabase requires a region for the S3 protocol but ignores the value.
AWS_S3_REGION_NAME=us-east-1
# Optional: a CDN or custom domain in front of the bucket. Derived from the
# endpoint and bucket when unset.
# AWS_S3_CUSTOM_DOMAIN=
