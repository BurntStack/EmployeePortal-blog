# BurntStack Employee Portal backend — copy to .env and fill in your values
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection string, e.g. a Supabase project (leave unset for SQLite locally)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DB_SSL_REQUIRE=True

# Include the marketing site's origin so burntstack.com/blog can read the
# public post feed from this backend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.burntstack.com,https://burntstack.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Google Sign-In — Client ID from Google Cloud Console (OAuth consent
# screen + Web application credential). Login is rejected entirely until
# this is set to a real value.
GOOGLE_CLIENT_ID=
# Anyone with a verified Google account on this domain can log in.
ALLOWED_EMAIL_DOMAIN=burntstack.com
# Comma-separated emails that get is_staff on every login (re-synced each
# time, so editing this takes effect immediately without touching the DB).
ADMIN_EMAILS=
